BITGET_API_KEY=bitget_api_key
BITGET_API_SECRET=bitget_api_secret
BITGET_API_PASSPHRASE=bitget_api_passphrase
# Gerçek hesap için Demo anahtarlarından tamamen ayrı bir API anahtarı kullanın.
BITGET_LIVE_API_KEY=live_api_key
BITGET_LIVE_API_SECRET=live_api_secret
BITGET_LIVE_API_PASSPHRASE=live_api_passphrase
APP_CONTROL_TOKEN=replace_with_a_long_random_token
PORT=8787

# Güvenli varsayılan: DEMO. Canlı hesap için README'deki dört kilidin tamamı
# bilinçli biçimde değiştirilmeden gerçek para emri gönderilmez.
EXECUTION_MODE=DEMO
DEMO_ONLY=true
LIVE_TRADING_ENABLED=false
LIVE_TRADING_CONFIRM=
LIVE_AUTO_TRADING_ENABLED=false

MAX_ORDER_USDT=10
MAX_LEVERAGE=3
ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
BITGET_POSITION_MODE=one_way_mode

# Canlı modda genel limitlerden daha düşük olan değer uygulanır.
LIVE_MAX_ORDER_USDT=5
LIVE_MAX_LEVERAGE=2
LIVE_MAX_DAILY_LOSS_USDT=5
LIVE_MAX_DAILY_ORDERS=2
LIVE_MAX_RISK_PER_TRADE_PCT=0.50
LIVE_MAX_MARGIN_PERCENT=5
LIVE_MAX_DAILY_LOSS_PCT=1
LIVE_MAX_DRAWDOWN_PCT=3

# Sunucu otomatik pilotu. İlk dağıtımda false bırakın; bağlantı ve demo hesabı
# doğrulandıktan sonra Railway Variables ekranında true yapın.
AUTO_TRADING_ENABLED=false
AUTO_RESUME_ON_RESTART=false
AUTO_REQUIRE_EXCLUSIVE_ACCOUNT=true
AUTO_MAX_OPEN_POSITIONS=1
AUTO_SCAN_SECONDS=60
AUTO_RECONCILE_SECONDS=30
# Railway'de kalıcı Volume /data yoluna bağlandıysa /data/automation-state.json kullanın.
AUTO_STATE_FILE=./data/automation-state.json
AUTO_LEVERAGE=3
AUTO_RISK_PER_TRADE_PCT=0.25
AUTO_MAX_MARGIN_PERCENT=5
AUTO_FEE_SLIPPAGE_BPS=15
AUTO_MIN_EQUITY_USDT=50
AUTO_MIN_DIRECTION_SCORE=80
AUTO_MIN_ENTRY_SCORE=75
AUTO_MAX_ATR_PERCENT=3.5
AUTO_MAX_DAILY_LOSS_USDT=10
AUTO_MAX_DAILY_LOSS_PCT=1
AUTO_MAX_DRAWDOWN_PCT=3
AUTO_MAX_DAILY_ORDERS=3
AUTO_MAX_CONSECUTIVE_LOSSES=2
AUTO_COOLDOWN_HOURS=6
